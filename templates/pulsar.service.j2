# Generated by Ansible (pulsar-rabbitmq-src)
[Unit]
Description=Pulsar (RabbitMQ message queue)
After=network-online.target docker.service{{ ' autofs.service' if _pulsar_cvmfs | bool else '' }}
Wants=network-online.target

[Service]
Type=simple
User={{ pulsar_user }}
Group={{ pulsar_user }}
UMask=022
WorkingDirectory={{ _pulsar_root }}
# server.ini only configures logging; Pulsar reads app.yml from the same directory.
ExecStart={{ pulsar_venv }}/bin/pulsar-main --config_dir {{ pulsar_config_dir }} --ini_path {{ pulsar_config_dir }}/server.ini
Restart=always
RestartSec=10
# Apptainer from the PPA is unprivileged (no setuid starter) and still works
# under no_new_privs: Ubuntu 24.04 allows its AppArmor user-namespace profile.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
