# Generated by Ansible (pulsar-rabbitmq-src). Contains the RabbitMQ password.
# Pulsar consumes jobs from the Galaxy's RabbitMQ over AMQPS as BYOC user
# {{ _pulsar_amqp.mq_user }}, matching the runner byoc-sync writes for it
# (byoc-sync/src/byoc_sync/templates/eu/runner.yml.j2).
# No `?ssl=1` in the URL, unlike that runner's: kombu would let it replace the
# amqp_connect_ssl_* settings below; with them, TLS is on and verifies the certificate
# and hostname.
message_queue_url: {{ _pulsar_amqp.url | to_json }}
amqp_connect_ssl_cert_reqs: cert_required
amqp_connect_ssl_ca_certs: {{ pulsar_amqp_ca_certs | to_json }}
# py-amqp checks the certificate's hostname only when this is set.
amqp_connect_ssl_server_hostname: {{ _pulsar_amqp.host | to_json }}
# As in byoc-sync's runner for this Pulsar (usegalaxy.eu: pulsar_eu_{{ _pulsar_amqp.name }}_byoc).
amqp_acknowledge: true
amqp_ack_republish_time: {{ _pulsar_amqp.ack_republish_time }}
amqp_publish_retry: true
amqp_publish_retry_max_retries: 60
amqp_publish_retry_interval_start: 10
amqp_publish_retry_interval_step: 10
amqp_publish_retry_interval_max: 60

# Galaxy's jobs_directory for this Pulsar: <nfs_path>/staging.
staging_directory: {{ _pulsar_amqp.jobs_directory | to_json }}
persistence_directory: {{ pulsar_persistence_dir | to_json }}
job_metrics_config_file: {{ (pulsar_config_dir ~ '/job_metrics_conf.xml') | to_json }}

# byoc-sync's runner uses manager "{{ _pulsar_amqp.manager }}"; only its name matters to Galaxy.
managers:
  {{ _pulsar_amqp.manager | to_json }}:
{% if _pulsar_slurm | bool %}
    # Jobs go to Slurm on this workspace through DRMAA (DRMAA_LIBRARY_PATH in the unit).
    type: queued_drmaa
{% else %}
    type: queued_python
    num_concurrent_jobs: {{ pulsar_num_concurrent_jobs | int }}
{% endif %}
    min_polling_interval: 0.5
