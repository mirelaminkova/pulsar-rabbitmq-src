#!/bin/sh
# Generated by Ansible (pulsar-rabbitmq-src). Slurm's TaskProlog: runs as the job's
# user before each job and adds every "export NAME=value" it prints to the job's
# environment. Slurm jobs run outside the pulsar unit, so they get the storage's
# temporary and Apptainer directories here, as Pulsar's own jobs get them from the unit.
echo export TMPDIR={{ pulsar_job_tmp_dir }}
{% if _pulsar_amqp.singularity_enabled %}
echo export APPTAINER_CACHEDIR={{ pulsar_apptainer_cache_dir }}
echo export APPTAINER_TMPDIR={{ pulsar_apptainer_tmp_dir }}
{% endif %}
