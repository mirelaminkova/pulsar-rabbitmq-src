#!/bin/sh
# Generated by Ansible (pulsar-rabbitmq-src). Slurm's TaskProlog: runs as the job's
# user before each task and adds every "export NAME=value" it prints to the task's
# environment. Slurm jobs run outside the pulsar unit, so they get the storage's home,
# temporary and Apptainer directories here; each job its own temporary directory,
# which the task epilog removes at the end of the job. A failure fails the task.
case "$SLURM_JOB_ID" in
  ''|*[!0-9]*) exit 0 ;;
esac
mkdir -p "{{ pulsar_job_tmp_dir }}/$SLURM_JOB_ID" || exit 1
echo "export HOME={{ pulsar_home }}"
echo "export TMPDIR={{ pulsar_job_tmp_dir }}/$SLURM_JOB_ID"
{% if _pulsar_amqp.singularity_enabled %}
echo "export APPTAINER_CACHEDIR={{ pulsar_apptainer_cache_dir }}"
echo "export APPTAINER_TMPDIR={{ pulsar_apptainer_tmp_dir }}"
{% endif %}
