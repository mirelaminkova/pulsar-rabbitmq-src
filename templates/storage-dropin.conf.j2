# Generated by Ansible (pulsar-rabbitmq-src): start {{ item.unit }} only with the
# storage (files/check_storage.py), and keep trying until it is there.
[Unit]
StartLimitIntervalSec=0
# Stopped before the volume is unmounted at shutdown.
After=local-fs.target remote-fs.target
[Service]
ExecStartPre=/usr/bin/python3 -I {{ pulsar_storage_check_script }} {{ item.option }}{{ _pulsar_amqp.storage_path }}
{% for line in item.service %}
{{ line }}
{% endfor %}
