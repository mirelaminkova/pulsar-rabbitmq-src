# Generated by Ansible (pulsar-rabbitmq-src)
# AMQPS for remote Galaxy servers: TLS ends here, RabbitMQ listens on 127.0.0.1 only.
stream {
    server {
        listen {{ rabbitmq_amqps_port }} ssl;
        ssl_certificate {{ _rabbitmq_tls_cert }};
        ssl_certificate_key {{ _rabbitmq_tls_key }};
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_session_cache shared:pulsar_amqps:1m;
        proxy_pass 127.0.0.1:{{ rabbitmq_amqp_port }};
        proxy_connect_timeout 10s;
        # AMQP heartbeats (60 s by default) keep connections busy; consumers with
        # heartbeats switched off must not be cut every 10 minutes (nginx default).
        proxy_timeout 1h;
    }
}
