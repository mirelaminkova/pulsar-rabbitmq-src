#!/bin/sh
# Generated by Ansible (pulsar-rabbitmq-src). Slurm's TaskEpilog: runs as the job's user
# after each task. Only the end of the batch step (the job script, which ends after its
# srun steps) removes the job's temporary directory (see task_prolog.sh).
case "$SLURM_JOB_ID" in
  ''|*[!0-9]*) exit 0 ;;
esac
# The batch step has no SLURM_STEP_ID (or "batch", 4294967294); srun steps a number.
case "${SLURM_STEP_ID:-batch}" in
  batch|4294967294) rm -rf -- "{{ pulsar_job_tmp_dir }}/$SLURM_JOB_ID" ;;
esac
exit 0
