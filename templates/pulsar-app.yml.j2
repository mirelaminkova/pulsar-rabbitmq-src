# Generated by Ansible (pulsar-rabbitmq-src). Contains the RabbitMQ pair password.
# An amqp:// message_queue_url makes Pulsar consume jobs from RabbitMQ (webless).
message_queue_url: {{ ('amqp://' ~ rabbitmq_pair_username ~ ':' ~ _rabbitmq_pair_password ~ '@127.0.0.1:' ~ rabbitmq_amqp_port ~ '/' ~ rabbitmq_vhost) | to_json }}
{% if pulsar_amqp_key_prefix | default('', true) | length > 0 %}
# Must match amqp_key_prefix on Galaxy's runner.
amqp_key_prefix: {{ pulsar_amqp_key_prefix | to_json }}
{% endif %}
# Must match amqp_acknowledge on Galaxy's runner.
amqp_acknowledge: {{ pulsar_amqp_acknowledge | bool | to_json }}
# Retry publishing status updates while RabbitMQ restarts.
amqp_publish_retry: true
amqp_publish_retry_max_retries: 60
amqp_publish_retry_interval_start: 10
amqp_publish_retry_interval_step: 10
amqp_publish_retry_interval_max: 60

staging_directory: {{ pulsar_staging_dir | to_json }}
persistence_directory: {{ pulsar_persistence_dir | to_json }}
job_metrics_config_file: {{ (pulsar_config_dir ~ '/job_metrics_conf.xml') | to_json }}

# The manager name must match `manager` on Galaxy's runner.
managers:
{{ pulsar_managers | to_nice_yaml(indent=2) | indent(2, true) }}
