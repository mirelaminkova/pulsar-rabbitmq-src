# Generated by Ansible (pulsar-rabbitmq-src)
[Unit]
Description=Pulsar (jobs from Galaxy's RabbitMQ)
After=network-online.target{{ ' docker.service' if _pulsar_amqp.docker_enabled else '' }}{{ ' autofs.service' if _pulsar_cvmfs | bool else '' }}{{ ' munge.service slurmctld.service' if _pulsar_slurm | bool else '' }}
Wants=network-online.target

[Service]
Type=simple
User={{ pulsar_user }}
Group={{ pulsar_user }}
UMask=022
WorkingDirectory={{ pulsar_home }}
# server.ini only configures logging; Pulsar reads app.yml from the same directory.
{% if _pulsar_slurm | bool %}
# Pulsar's queued_drmaa manager submits jobs to Slurm as this user; slurmd runs
# them as pulsar too, outside this unit, so without its sandboxing below
# (NoNewPrivileges, PrivateTmp, ProtectHome).
Environment=DRMAA_LIBRARY_PATH={{ pulsar_drmaa_library_path }}
{% endif %}
ExecStart={{ pulsar_venv }}/bin/pulsar-main --config_dir {{ pulsar_config_dir }} --ini_path {{ pulsar_config_dir }}/server.ini
Restart=always
RestartSec=10
# Apptainer from the PPA is unprivileged (no setuid starter) and still works
# under no_new_privs: Ubuntu 24.04 allows its AppArmor user-namespace profile.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true

[Install]
WantedBy=multi-user.target
